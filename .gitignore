# Large raw data files
01-data/raw/*.pdf
01-data/raw/*.jpg
01-data/raw/*.png
01-data/raw/*.txt

# Sensitive files
01-data/openai-api.txt

# Database (large binary)
01-data/soldiers.db

# Large source files
01-data/brigades/

# Generated exports (can regenerate)
01-data/exports/
01-data/archive/
01-data/temp/

# Old processed folder
01-data/processed/

# Logs
logs/

# Pipeline workspaces (intermediate processing files)
pipeline/workspaces/*
!pipeline/workspaces/.gitignore

# Misc
nul
temp_photos/

# Claude Code local settings
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next/
out/
*.next-env.d.ts
